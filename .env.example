# Port the API listens on. Defaults to 8000
PORT=8000

# Set to "production" in deployed environments (secure cookies, production CORS allow-list)
NODE_ENV=development

# MongoDB connection string. Must be a replica set (e.g. MongoDB Atlas) because transactions are used
MONGO_URL=

# Secret used to sign and verify JWTs. Use a long random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET=

# Public URL of the frontend, used for Stripe success/cancel redirects (no trailing slash)
# Local: http://localhost:3000
CLIENT_URL=http://localhost:3000

# Stripe secret key (sk_test_... or sk_live_...)
stripe_key=

# Cloudinary credentials for product image uploads
cloudinary_cloud_name=
cloudinary_api_key=
cloudinary_api_secret=

# SMTP mailbox for verification, password reset and contact emails (port 465, TLS)
SMTP_HOST=
EMAIL_ADDRESS=
EMAIL_PASSWORD=

# Inbox that receives messages sent through the contact form
SUPPORT_EMAIL=

# Set to "false" on extra instances so only one runs the scheduled jobs. Defaults to running them
RUN_CRONS=true
